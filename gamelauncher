
#!/bin/bash

declare -A games

# Steam
STEAM_DIR="$HOME/.local/share/Steam/steamapps"

for file in "$STEAM_DIR"/appmanifest_*.acf; do
    [ -f "$file" ] || continue

    name=$(grep -m1 '"name"' "$file" | sed 's/.*"name"[[:space:]]*"\(.*\)"/\1/')
    appid=$(grep -m1 '"appid"' "$file" | sed 's/.*"appid"[[:space:]]*"\(.*\)"/\1/')

    case "$name" in
        *"Steam Linux Runtime"*|*"Proton"*|*"Steamworks"*|*"SteamVR"*|*"SteamOS"*|*"Runtime"*)
            continue
            ;;
    esac

    if [ -n "$name" ] && [ -n "$appid" ]; then
        games["$name"]="steam -silent steam://rungameid/$appid"
    fi
done


# GameCube / Wii Dolphin
for rom in "$HOME/rom/gamecube/"* "$HOME/rom/wii/"*; do
    [ -f "$rom" ] || continue

    name=$(basename "$rom")
    name="${name%.*}"

    games["$name"]="dolphin-emu -b \"$rom\""
done


# Menu
choice=$(printf "%s\n" "${!games[@]}" | sort | fzf \
    --prompt="" \
    --height=60% \
    --border=rounded)

if [ -n "$choice" ]; then
    eval "${games[$choice]}" &
fi
